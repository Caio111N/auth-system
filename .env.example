# ------------------------------------------------------------
# MONGODB: escolha URI local ou Atlas e mantenha apenas MONGODB_URI ativo
# ------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/auth-system
# Atlas: mongodb+srv://<usuario>:<senha>@<cluster>/<banco>
MONGODB_URI=<URI_DO_MONGODB_LOCAL_OU_ATLAS>

# ------------------------------------------------------------
# SEGURANÇA E SERVIDOR: valores de ambiente locais (somente placeholders)
# ------------------------------------------------------------
JWT_SECRET=<SEGREDO_COM_PELO_MENOS_32_CARACTERES>
RESET_PASSWORD_URL=<URL_DA_PAGINA_DE_REDEFINICAO>
PORT=<PORTA_HTTP>
LOG_LEVEL=<NIVEL_DE_LOG>
CORS_ORIGINS=<ORIGENS_HTTP_SEPARADAS_POR_VIRGULA>

# ------------------------------------------------------------
# E-MAIL: configure o conjunto completo de variáveis SMTP ou deixe vazio em desenvolvimento
# ------------------------------------------------------------
SMTP_HOST=<HOST_SMTP>
SMTP_PORT=<PORTA_SMTP>
SMTP_USER=<USUARIO_SMTP>
SMTP_PASS=<SENHA_SMTP>
MAIL_FROM=<REMETENTE_DO_EMAIL>

# ------------------------------------------------------------
# SESSÕES: validade curta e longa dos refresh tokens
# ------------------------------------------------------------
REFRESH_TOKEN_SHORT_TTL_DAYS=<VALIDADE_DA_SESSAO_SEM_LEMBRAR>
REFRESH_TOKEN_LONG_TTL_DAYS=<VALIDADE_DA_SESSAO_COM_LEMBRAR>

# ------------------------------------------------------------
# LIMITES E VERIFICAÇÃO: proteção contra abuso e confirmação opcional
# ------------------------------------------------------------
TRUST_PROXY=<FALSE_TRUE_SALTOS_O_IPS_CIDRS_CONFIAVEIS>
RATE_LIMIT_WINDOW_MS=<JANELA_DE_RATE_LIMIT_EM_MS>
LOGIN_RATE_LIMIT_MAX=<LIMITE_LOGIN_POR_IP>
LOGIN_EMAIL_RATE_LIMIT_MAX=<LIMITE_LOGIN_POR_EMAIL>
REGISTER_RATE_LIMIT_MAX=<LIMITE_CADASTRO_POR_IP>
FORGOT_PASSWORD_RATE_LIMIT_MAX=<LIMITE_RECUPERACAO_POR_IP>
EMAIL_VERIFICATION_RATE_LIMIT_MAX=<LIMITE_REENVIO_DE_CONFIRMACAO_POR_IP_E_EMAIL>
RESET_PASSWORD_RATE_LIMIT_MAX=<LIMITE_REDEFINICAO_POR_IP>
REFRESH_RATE_LIMIT_MAX=<LIMITE_REFRESH_POR_IP>
LOGIN_MAX_FAILED_ATTEMPTS=<FALHAS_ANTES_DO_BLOQUEIO>
LOGIN_BLOCK_DURATION_MINUTES=<DURACAO_DO_BLOQUEIO_EM_MINUTOS>
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL_HOURS=<VALIDADE_DO_TOKEN_DE_VERIFICACAO_EM_HORAS>
