{
    "name": "auth-system",
    "version": "1.0.0",
    "description": "Sistema de autenticacao com Express, MongoDB, JWT em cookies seguros e verificacao de e-mail.",
    "main": "src/app.js",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "dev:chrome": "node scripts/dev-chrome.js",
        "test": "node --test",
        "test:coverage": "node --experimental-test-coverage --test",
        "lint": "eslint src test public scripts",
        "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"public/**/*.{js,html,css}\" \"scripts/**/*.js\" eslint.config.js package.json .prettierrc.json README.md SECURITY.md CHANGELOG.md .github/workflows/ci.yml"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^7.6.0",
        "mongoose": "^9.9.5",
        "nodemailer": "^10.0.13",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "globals": "^17.13.0",
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.9",
        "supertest": "^7.3.0"
    }
}
